# Copy to `.env` and fill in values. Validated by app/env.server.ts.
# No NODE_ENV here: app/env.server.ts defaults it to development, and a NODE_ENV in this file would leak into the
# client bundle of a local build.

# PostgreSQL connection string, used by the app and Drizzle Kit (drizzle.config.ts).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zurvan

# Better-Auth: signs session cookies. Generate with `openssl rand -base64 32` (min 32 chars).
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more
# Public origin of the app (the Vite dev server by default).
BETTER_AUTH_URL=http://localhost:5173
# Optional server IPv4 address for HTTP access alongside the HTTPS domain.
# HTTP_IP=203.0.113.10

# Showcase mode: no SMS is sent, the sign-in code is always 12345, and messages are written to the sms_outbox table.
# Auth refuses to start with it off until a real SMS provider is wired.
SHOWCASE_MODE=true

# Media storage (docs/media.md): S3-compatible SeaweedFS. The app writes uploaded images here and browsers read them.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET_NAME=zurvann
# Any value works while local S3 auth is off; production uses the app's identity key and secret.
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
# Only needed to sign requests; SeaweedFS ignores it. Defaults to us-east-1.
S3_REGION=us-east-1
# Where browsers load images from: a full URL in development, `/media` behind nginx in production.
MEDIA_PUBLIC_URL=http://localhost:8333/zurvann

# TODO: remove once the Cloudflare demo deploy has real env vars. Set to `true` to skip validation in app/env.server.ts
# (it is also skipped automatically on Cloudflare Workers).
# SKIP_ENV_VALIDATION=true
