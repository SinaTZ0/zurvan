{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@tanstack/react-router",
            "importNames": ["Link"],
            "message": "Import Link from ~/components/link or NavLink from ~/components/nav-link, which add the site's preload and hash-scroll defaults (docs/view-transitions.md)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["app/components/ui/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "react/set-state-in-effect": "off",
        "react/no-unstable-nested-components": "off",
        "eslint/no-shadow": "off",
        "eslint/no-underscore-dangle": "off"
      }
    },
    {
      "files": ["app/components/link.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".output/",
    ".nitro/",
    ".tanstack/",
    "app/routeTree.gen.ts",
    "playwright-report/",
    "test-results/",
    "storybook-static/"
  ]
}
