{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 110MB
	}

	# The unauthenticated S3 service has no public ports. Only generated image
	# variants are public; videos go through the app's authenticated routes.
	@media path /media /media/*
	handle @media {
		@image {
			method GET HEAD
			path_regexp image ^/media/((avatar|dog|course|certificate|evaluation)/[0-9a-f-]{36}/[a-z]+\.webp)$
		}
		handle @image {
			# Drop all query parameters so callers cannot select S3 API operations.
			rewrite * /zurvann/{re.image.1}?
			reverse_proxy seaweedfs:8333 {
				header_up Host seaweedfs:8333
				header_up -Authorization
				header_up -Cookie
				header_down -x-amz-request-id
				header_down -x-amz-id-2
			}
		}
		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy app:3000
	}
}
