(application) {
	encode zstd gzip
	request_body {
		max_size 110MB
	}

	# Public images keep stable filenames, so refresh their browser cache daily.
	# Match successful responses only, and override the app's max-age=0 on write.
	@staticImages {
		method GET HEAD
		path /photo/* /brand/* /demo/* /favicon.ico /favicon-*.png /apple-touch-icon.png
	}
	header @staticImages Cache-Control "public, max-age=86400" {
		match status 2xx 304
	}

	# The unauthenticated S3 service has no public ports. Only generated image
	# variants are public; videos go through the app's authenticated routes.
	@media path /media /media/*
	handle @media {
		@image {
			method GET HEAD
			path_regexp image ^/media/((avatar|dog|course|certificate|evaluation)/[0-9a-f-]{36}/[a-z]+\.webp)$
		}
		handle @image {
			# Drop all query parameters so callers cannot select S3 API operations.
			rewrite * /zurvann/{re.image.1}?
			reverse_proxy seaweedfs:8333 {
				header_up Host seaweedfs:8333
				header_up -Authorization
				header_up -Cookie
				header_down -x-amz-request-id
				header_down -x-amz-id-2
			}
		}
		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy app:3000
	}
}

{$DOMAIN} {
	import application
}

# IP access stays on HTTP; the domain keeps automatic HTTPS and redirects.
http://{$HTTP_IP:127.0.0.1} {
	import application
}
