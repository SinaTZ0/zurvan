# Zurvan — Phase One entities
#
# Source of truth: docs/app-phase-one.md (section 4).
# The root board is an index. Every entity has its own board under `layers`,
# showing its fields, its direct relationships, its status lifecycle (when it
# has one) and the business rules that shape it.
#
# Render (one linked SVG per board):  d2 docs/entities.d2 entities.svg
# Live preview with clickable boards: d2 --watch docs/entities.d2

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 48
  }
}

# ===== Shared styles =====
# Each domain has one colour. `t-*` styles the board's main table,
# `n-*` styles the neighbouring entities, `g-*` styles the index groups.
# For sql_table, `fill` colours the header and `stroke` colours the body.

classes: {
  # ------ People & access ------
  t-people: {shape: sql_table; style: {fill: "#2B6CB0"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-people: {style: {fill: "#EBF4FF"; stroke: "#2B6CB0"; font-color: "#1A365D"; border-radius: 8}}
  g-people: {style: {fill: "#F5F9FF"; stroke: "#2B6CB0"; font-color: "#1A365D"; border-radius: 12}}

  # ------ Catalogue ------
  t-catalogue: {shape: sql_table; style: {fill: "#2F855A"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-catalogue: {style: {fill: "#E6F6EC"; stroke: "#2F855A"; font-color: "#1C4532"; border-radius: 8}}
  g-catalogue: {style: {fill: "#F4FBF6"; stroke: "#2F855A"; font-color: "#1C4532"; border-radius: 12}}

  # ------ Booking ------
  t-booking: {shape: sql_table; style: {fill: "#2C7A7B"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-booking: {style: {fill: "#E6FFFA"; stroke: "#2C7A7B"; font-color: "#1D4044"; border-radius: 8}}
  g-booking: {style: {fill: "#F2FFFC"; stroke: "#2C7A7B"; font-color: "#1D4044"; border-radius: 12}}

  # ------ Sales ------
  t-sales: {shape: sql_table; style: {fill: "#B83280"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-sales: {style: {fill: "#FFF0F7"; stroke: "#B83280"; font-color: "#521B41"; border-radius: 8}}
  g-sales: {style: {fill: "#FFF7FB"; stroke: "#B83280"; font-color: "#521B41"; border-radius: 12}}

  # ------ Wallet & payouts ------
  t-money: {shape: sql_table; style: {fill: "#975A16"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-money: {style: {fill: "#FFF8E1"; stroke: "#975A16"; font-color: "#5F370E"; border-radius: 8}}
  g-money: {style: {fill: "#FFFCF0"; stroke: "#975A16"; font-color: "#5F370E"; border-radius: 12}}

  # ------ Partners ------
  t-partner: {shape: sql_table; style: {fill: "#C05621"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-partner: {style: {fill: "#FFF1E6"; stroke: "#C05621"; font-color: "#652B19"; border-radius: 8}}
  g-partner: {style: {fill: "#FFF8F2"; stroke: "#C05621"; font-color: "#652B19"; border-radius: 12}}

  # ------ Community ------
  t-community: {shape: sql_table; style: {fill: "#6B46C1"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-community: {style: {fill: "#F3EEFF"; stroke: "#6B46C1"; font-color: "#322659"; border-radius: 8}}
  g-community: {style: {fill: "#FAF7FF"; stroke: "#6B46C1"; font-color: "#322659"; border-radius: 12}}

  # ------ System ------
  t-system: {shape: sql_table; style: {fill: "#4A5568"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; shadow: true}}
  n-system: {style: {fill: "#EDF2F7"; stroke: "#4A5568"; font-color: "#1A202C"; border-radius: 8}}
  g-system: {style: {fill: "#F7FAFC"; stroke: "#4A5568"; font-color: "#1A202C"; border-radius: 12}}

  # ------ Relationships (crow's foot) ------
  # The first entity in `a <-> b` is the parent side.
  one-to-one: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-one-required; style.stroke: "#7B8794"}
  one-to-optional: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-one; style.stroke: "#7B8794"}
  one-to-many: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many; style.stroke: "#7B8794"}
  one-to-some: {source-arrowhead.shape: cf-one-required; target-arrowhead.shape: cf-many-required; style.stroke: "#7B8794"}
  optional-to-many: {source-arrowhead.shape: cf-one; target-arrowhead.shape: cf-many; style.stroke: "#7B8794"}
  many-to-many: {source-arrowhead.shape: cf-many; target-arrowhead.shape: cf-many; style.stroke: "#7B8794"}
  # Not a stored foreign key: a copy, a calculation or a lookup.
  derived: {style: {stroke: "#9AA5B1"; stroke-dash: 4; font-color: "#7B8794"}}

  # ------ Lifecycles ------
  lifecycle: {style: {fill: "#FAFBFC"; stroke: "#CBD2D9"; stroke-dash: 4; border-radius: 12; font-color: "#52606D"; font-size: 18}}
  start: {shape: circle; width: 16; height: 16; label: ""; style: {fill: "#52606D"; stroke: "#52606D"}}
  st: {style: {fill: "#FFFFFF"; stroke: "#9AA5B1"; font-color: "#323F4B"; border-radius: 20; font-size: 14}}
  st-good: {style: {fill: "#E3F9E5"; stroke: "#2F855A"; font-color: "#1C4532"; border-radius: 20; font-size: 14}}
  st-bad: {style: {fill: "#FFE3E3"; stroke: "#C53030"; font-color: "#63171B"; border-radius: 20; font-size: 14}}
  st-wait: {style: {fill: "#FFFBEA"; stroke: "#B7791F"; font-color: "#5F370E"; border-radius: 20; font-size: 14}}
  flow: {style: {stroke: "#52606D"; font-color: "#52606D"; font-size: 13}}

  # ------ Board layout ------
  # Invisible grid cells: relationships on the left, lifecycle and rules on the right.
  area: {label: ""; style: {fill: transparent; stroke: transparent}}

  # ------ Notes ------
  rules: {style: {font-color: "#323F4B"; font-size: 18}}
  back: {style: {fill: "#FFFFFF"; stroke: "#CBD2D9"; border-radius: 16; font-color: "#52606D"; font-size: 13}}
}

# ===== Index =====

title: |md
  # Zurvan — Phase One Entities

  Click an entity to open its board. Every table also has `id` (UUID), `created_at` and `updated_at`.
  Money is stored as whole **Rial**. Dates are stored in UTC and shown in the Jalali calendar.
| {near: top-center}

legend: |||md
  **Reading the lines**

  - `||` exactly one · `o|` zero or one
  - `|<` one or more · `o<` zero or more
  - Dashed line: a copy, calculation or lookup, not a stored link
||| {near: bottom-center}

domains: {
  label: ""
  grid-columns: 4
  grid-gap: 32
  style: {fill: transparent; stroke: transparent}

  people: People & access {
    class: g-people
    grid-columns: 1
    grid-gap: 12
    user: User {class: n-people; link: layers.user}
    trainer_profile: Trainer Profile {class: n-people; link: layers.trainer_profile}
    partner_profile: Partner Profile {class: n-people; link: layers.partner_profile}
    pet: Pet {class: n-people; link: layers.pet}
  }

  catalogue: Catalogue {
    class: g-catalogue
    grid-columns: 1
    grid-gap: 12
    course: Course {class: n-catalogue; link: layers.course}
    course_prerequisite: Course Prerequisite {class: n-catalogue; link: layers.course_prerequisite}
    course_run: Course Run {class: n-catalogue; link: layers.course_run}
    course_session: Course Session {class: n-catalogue; link: layers.course_session}
    refund_policy: Refund Policy {class: n-catalogue; link: layers.refund_policy}
  }

  booking: Booking {
    class: g-booking
    grid-columns: 1
    grid-gap: 12
    enrollment: Enrollment {class: n-booking; link: layers.enrollment}
    waitlist_entry: Waitlist Entry {class: n-booking; link: layers.waitlist_entry}
  }

  sales: Sales {
    class: g-sales
    grid-columns: 1
    grid-gap: 12
    discount_code: Discount Code {class: n-sales; link: layers.discount_code}
    order: Order {class: n-sales; link: layers.order}
    order_item: Order Item {class: n-sales; link: layers.order_item}
    payment: Payment {class: n-sales; link: layers.payment}
  }

  money: Wallet & payouts {
    class: g-money
    grid-columns: 1
    grid-gap: 12
    wallet: Wallet {class: n-money; link: layers.wallet}
    wallet_transaction: Wallet Transaction {class: n-money; link: layers.wallet_transaction}
    wallet_credit_usage: Wallet Credit Usage {class: n-money; link: layers.wallet_credit_usage}
    withdrawal_request: Withdrawal Request {class: n-money; link: layers.withdrawal_request}
    withdrawal_request_item: Withdrawal Request Item {class: n-money; link: layers.withdrawal_request_item}
    trainer_settlement: Trainer Settlement {class: n-money; link: layers.trainer_settlement}
  }

  partner: Partners {
    class: g-partner
    grid-columns: 1
    grid-gap: 12
    partner_lead: Partner Lead {class: n-partner; link: layers.partner_lead}
    commission_plan: Commission Plan {class: n-partner; link: layers.commission_plan}
    commission_tier: Commission Tier {class: n-partner; link: layers.commission_tier}
    commission_statement: Commission Statement {class: n-partner; link: layers.commission_statement}
  }

  community: Community {
    class: g-community
    grid-columns: 1
    grid-gap: 12
    review: Review {class: n-community; link: layers.review}
    comment: Comment {class: n-community; link: layers.comment}
  }

  system: System {
    class: g-system
    grid-columns: 1
    grid-gap: 12
    otp_code: OTP Code {class: n-system; link: layers.otp_code}
    platform_setting: Platform Setting {class: n-system; link: layers.platform_setting}
  }
}

layers: {
  # ===== People & access =====

  user: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # User
      Everyone who signs in: admins, trainers, partners and customers.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      user: User {
        class: t-people
        id: uuid {constraint: primary_key}
        phone_number: "string (09xxxxxxxxx)" {constraint: unique}
        phone_verified_at: datetime
        first_name: string
        last_name: string
        avatar: image
        role: "Admin | Trainer | Partner | Customer"
        status: "Active | Blocked"
        referred_by: "uuid (partner)" {constraint: foreign_key}
        referral_source: "Link | QR Code | Pre-registration | None"
        referred_at: datetime
        last_login_at: datetime
        deleted_at: datetime
      }
      # ------ Relationships ------
      referrer: "User (partner)" {class: n-people; link: _.layers.user}
      trainer_profile: Trainer Profile {class: n-people; link: _.layers.trainer_profile}
      partner_profile: Partner Profile {class: n-people; link: _.layers.partner_profile}
      wallet: Wallet {class: n-money; link: _.layers.wallet}
      pet: Pet {class: n-people; link: _.layers.pet}
      order: Order {class: n-sales; link: _.layers.order}
      course: Course {class: n-catalogue; link: _.layers.course}
      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      withdrawal_request: Withdrawal Request {class: n-money; link: _.layers.withdrawal_request}
      partner_lead: Partner Lead {class: n-partner; link: _.layers.partner_lead}

      referrer <-> user: "referred (customers)" {class: optional-to-many}
      user <-> trainer_profile: "has (trainers)" {class: one-to-optional}
      user <-> partner_profile: "has (partners)" {class: one-to-optional}
      user <-> wallet: has {class: one-to-one}
      user <-> pet: owns {class: one-to-many}
      user <-> order: places {class: one-to-many}
      user <-> course: "creates / owns" {class: one-to-many}
      user <-> course_run: teaches {class: one-to-many}
      user <-> withdrawal_request: requests {class: one-to-many}
      user <-> partner_lead: "adds (partners)" {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40
      # ------ Lifecycle ------

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        active: Active {class: st-good}
        blocked: Blocked {class: st-bad}

        s -> active: "signs up / created by admin" {class: flow}
        active -> blocked: admin blocks {class: flow}
        blocked -> active: admin unblocks {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Sign-in is by phone number and a 5-digit SMS code only.
          - Only customers can sign up themselves. An admin creates trainers and partners.
          - Each phone number has exactly one role.
          - A customer's partner is set once, at sign-up, and never changes.
          - Blocked users can't log in.
        | {class: rules}
      }
    }
  }

  trainer_profile: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Trainer Profile
      The public face of a trainer, shown on course and run pages.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      trainer_profile: Trainer Profile {
        class: t-people
        id: uuid {constraint: primary_key}
        user_id: uuid {constraint: [foreign_key; unique]}
        bio: text
        specialties: "string[]"
        years_of_experience: int
        certificates: "file[]"
        city: string
        verified_at: datetime
        rating_average: decimal
        rating_count: int
      }

      user: "User (Trainer)" {class: n-people; link: _.layers.user}
      review: Review {class: n-community; link: _.layers.review}

      user <-> trainer_profile: has {class: one-to-optional}
      review -> trainer_profile: updates the rating {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - One profile per user whose role is Trainer.
          - An admin sets `verified_at`, which shows the "verified" badge.
          - Rating average and count come from customers' trainer ratings.
        | {class: rules}
      }
    }
  }

  partner_profile: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Partner Profile
      A pet shop, clinic or groomer that brings in customers.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      partner_profile: Partner Profile {
        class: t-partner
        id: uuid {constraint: primary_key}
        user_id: uuid {constraint: [foreign_key; unique]}
        business_name: string
        business_type: "Pet Shop | Veterinary Clinic | Groomer | Other"
        referral_code: string {constraint: unique}
        commission_plan_id: uuid {constraint: foreign_key}
        city: string
        address: string
        is_active: bool
      }

      user: "User (Partner)" {class: n-people; link: _.layers.user}
      customers: "User (referred customers)" {class: n-people; link: _.layers.user}
      commission_plan: Commission Plan {class: n-partner; link: _.layers.commission_plan}
      commission_statement: Commission Statement {class: n-partner; link: _.layers.commission_statement}
      partner_lead: Partner Lead {class: n-partner; link: _.layers.partner_lead}

      user <-> partner_profile: has {class: one-to-optional}
      commission_plan <-> partner_profile: assigned to {class: optional-to-many}
      partner_profile <-> commission_statement: earns {class: one-to-many}
      partner_profile <-> partner_lead: adds {class: one-to-many}
      partner_profile <-> customers: refers {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - The referral code is used in the partner's link and QR code.
          - No commission plan means the global default plan applies.
          - Links of inactive partners stop crediting new customers.
        | {class: rules}
      }
    }
  }

  pet: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Pet
      Pets enroll in courses, not their owners.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      pet: Pet {
        class: t-people
        id: uuid {constraint: primary_key}
        owner_id: "uuid (customer)" {constraint: foreign_key}
        name: string
        species: "Dog | Cat | Bird | Other"
        breed: string
        sex: "Male | Female"
        birth_date: "date (approximate)"
        weight_kg: decimal
        is_neutered: bool
        photo: image
        microchip_number: string
        vaccination_status: "Up to date | Partial | Unknown"
        behaviour_notes: text
        medical_notes: text
        deleted_at: datetime
      }

      user: "User (Customer)" {class: n-people; link: _.layers.user}
      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}
      waitlist_entry: Waitlist Entry {class: n-booking; link: _.layers.waitlist_entry}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}

      user <-> pet: owns {class: one-to-many}
      pet <-> enrollment: enrolled in {class: one-to-many}
      pet <-> waitlist_entry: waits in {class: one-to-many}
      pet <-> order_item: booked in {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - Age is calculated from the birth date and checked against the run's start date.
          - Behaviour and medical notes are shown to the trainer.
          - Eligibility (species, age, prerequisites) is checked per pet.
        | {class: rules}
      }
    }
  }

  # ===== Catalogue =====

  course: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Course
      The curriculum. Approved once, then scheduled as many runs.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      course: Course {
        class: t-catalogue
        id: uuid {constraint: primary_key}
        title: string
        slug: string {constraint: unique}
        short_description: string
        description: rich text
        cover_image: image
        category: "Obedience | Behaviour | Agility | Puppy"
        level: "Beginner | Intermediate | Advanced"
        created_by: uuid {constraint: foreign_key}
        owner_trainer_id: uuid {constraint: foreign_key}
        target_species: "species[]"
        min_pet_age_months: int
        max_pet_age_months: int
        session_count: int
        session_duration_minutes: int
        estimated_duration_weeks: int
        default_price: rial
        refund_policy_id: uuid {constraint: foreign_key}
        trainer_share_percent: decimal
        ineligibility_message: text
        status: "enum (see lifecycle)"
        rejection_reason: text
        admin_changes: "json (old → new)"
        admin_note: text
        approved_by: uuid {constraint: foreign_key}
        approved_at: datetime
        archived_at: datetime
        rating_average: decimal
        rating_count: int
        deleted_at: datetime
      }

      trainer: "User (owner trainer)" {class: n-people; link: _.layers.user}
      refund_policy: Refund Policy {class: n-catalogue; link: _.layers.refund_policy}
      course_prerequisite: Course Prerequisite {class: n-catalogue; link: _.layers.course_prerequisite}
      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      comment: Comment {class: n-community; link: _.layers.comment}
      review: Review {class: n-community; link: _.layers.review}

      trainer <-> course: owns {class: optional-to-many}
      refund_policy <-> course: applies to {class: one-to-many}
      course <-> course_prerequisite: requires {class: one-to-many}
      course <-> course_run: scheduled as {class: one-to-many}
      course <-> comment: has {class: one-to-many}
      review -> course: updates the rating {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        draft: Draft {class: st}
        pending: Pending Approval {class: st-wait}
        awaiting: Awaiting Trainer Confirmation {class: st-wait}
        rejected: Rejected {class: st-bad}
        approved: Approved {class: st-good}
        archived: Archived {class: st}

        s -> draft: {class: flow}
        draft -> pending: trainer submits {class: flow}
        pending -> approved: "admin approves (or force-approves edits)" {class: flow}
        pending -> rejected: admin rejects with reason {class: flow}
        rejected -> pending: trainer edits {class: flow}
        pending -> awaiting: admin edits and sends back {class: flow}
        awaiting -> approved: trainer accepts {class: flow}
        awaiting -> pending: trainer edits again {class: flow}
        approved -> archived: admin archives {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Courses created by an admin are approved directly.
          - After approval, the trainer can still edit text and images.
          - Prerequisites, species, age range, refund policy and trainer share are admin-only after approval.
          - Archived courses get no new runs. Existing runs continue.
        | {class: rules}
      }
    }
  }

  course_prerequisite: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Course Prerequisite
      A course the pet must have passed before it can enroll.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      course_prerequisite: Course Prerequisite {
        class: t-catalogue
        id: uuid {constraint: primary_key}
        course_id: uuid {constraint: foreign_key}
        required_course_id: uuid {constraint: foreign_key}
      }

      course: "Course (has the requirement)" {class: n-catalogue; link: _.layers.course}
      required: "Course (must be passed first)" {class: n-catalogue; link: _.layers.course}

      course <-> course_prerequisite: requires {class: one-to-many}
      required <-> course_prerequisite: is required by {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - Unique on (course, required course).
          - Met when the pet has **Passed** any run of the required course.
          - A course can't require itself, and requirements can't form a loop.
        | {class: rules}
      }
    }
  }

  course_run: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Course Run
      One scheduled class of a course: when, where, who, how many seats, what price.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      course_run: Course Run {
        class: t-catalogue
        id: uuid {constraint: primary_key}
        course_id: uuid {constraint: foreign_key}
        trainer_id: uuid {constraint: foreign_key}
        run_label: string
        format: "In Person | Online | Hybrid"
        city: string
        address: string
        start_date: datetime
        estimated_end_date: datetime
        schedule_note: string
        enrollment_deadline: datetime
        capacity: int
        min_reservations_to_start: int
        price: rial
        status: "enum (see lifecycle)"
        published_at: datetime
        confirmed_at: datetime
        cancelled_at: datetime
        cancellation_reason: text
        reserved_count: "int (cached)"
        deleted_at: datetime
      }

      course: Course {class: n-catalogue; link: _.layers.course}
      trainer: "User (trainer)" {class: n-people; link: _.layers.user}
      course_session: Course Session {class: n-catalogue; link: _.layers.course_session}
      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}
      waitlist_entry: Waitlist Entry {class: n-booking; link: _.layers.waitlist_entry}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}
      trainer_settlement: Trainer Settlement {class: n-money; link: _.layers.trainer_settlement}

      course <-> course_run: scheduled as {class: one-to-many}
      trainer <-> course_run: teaches {class: one-to-many}
      course_run <-> course_session: split into {class: one-to-many}
      course_run <-> enrollment: has {class: one-to-many}
      course_run <-> waitlist_entry: has {class: one-to-many}
      course_run <-> order_item: sold as {class: one-to-many}
      course_run <-> trainer_settlement: settled by {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        draft: Draft {class: st}
        published: Published {class: st-wait}
        confirmed: Confirmed {class: st-good}
        in_progress: In Progress {class: st-good}
        completed: Completed {class: st-good}
        cancelled: Cancelled {class: st-bad}

        s -> draft: {class: flow}
        draft -> published: trainer publishes {class: flow}
        published -> confirmed: minimum reached {class: flow}
        confirmed -> in_progress: start date {class: flow}
        in_progress -> completed: end date {class: flow}
        published -> cancelled: "minimum not reached by deadline, or admin cancels" {class: flow}
        confirmed -> cancelled: admin cancels {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Only for an **Approved** course. Runs don't need admin approval.
          - A run must never be overbooked, even when many people book at once.
          - After the first reservation, price, start date, capacity and location are admin-only.
          - A cancelled run refunds every paid seat in full, to the wallet.
          - Remaining seats = capacity − reserved count.
        | {class: rules}
      }
    }
  }

  course_session: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Course Session
      One meeting of a run. Optional in phase one.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      course_session: Course Session {
        class: t-catalogue
        id: uuid {constraint: primary_key}
        course_run_id: uuid {constraint: foreign_key}
        position: "int (1, 2, 3…)"
        title: string
        starts_at: datetime
        duration_minutes: int
        location_or_link: string
      }

      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}

      course_run <-> course_session: split into {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - Without sessions, the run's schedule note is enough.
          - Duration defaults to the course's session duration.
          - Location or link overrides the run's location.
        | {class: rules}
      }
    }
  }

  refund_policy: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Refund Policy
      A preset the admin defines. Each course uses one.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      refund_policy: Refund Policy {
        class: t-catalogue
        id: uuid {constraint: primary_key}
        name: string
        customer_description: text
        full_refund_until_days: int
        partial_refund_percent: decimal
        after_start_refund_percent: decimal
        is_active: bool
      }

      course: Course {class: n-catalogue; link: _.layers.course}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}

      refund_policy <-> course: applies to {class: one-to-many}
      refund_policy -> order_item: copied at purchase {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Example presets**
          - Flexible: full refund until 3 days before start, then 50%
          - Moderate: full refund until 7 days before start, then 50%
          - Strict: full refund until 14 days before start, then 0%

          **Rules**
          - Cancelling before the run is Confirmed always gets a full refund.
          - If the platform cancels a run, everyone gets a full refund.
          - Percentages apply to what the customer actually paid.
        | {class: rules}
      }
    }
  }

  # ===== Booking =====

  enrollment: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Enrollment
      One pet's seat in one run, and its result.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      enrollment: Enrollment {
        class: t-booking
        id: uuid {constraint: primary_key}
        course_run_id: uuid {constraint: foreign_key}
        pet_id: uuid {constraint: foreign_key}
        course_id: "uuid (copied)" {constraint: foreign_key}
        customer_id: "uuid (copied)" {constraint: foreign_key}
        order_item_id: uuid {constraint: [foreign_key; unique]}
        is_retake: bool
        status: "enum (see lifecycle)"
        hold_expires_at: datetime
        reserved_at: datetime
        cancelled_at: datetime
        cancellation_reason: text
        attended_sessions: int
        completed_date: date
        trainer_note: text
      }

      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      pet: Pet {class: n-people; link: _.layers.pet}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}
      waitlist_entry: Waitlist Entry {class: n-booking; link: _.layers.waitlist_entry}
      review: Review {class: n-community; link: _.layers.review}

      course_run <-> enrollment: has {class: one-to-many}
      pet <-> enrollment: enrolled in {class: one-to-many}
      order_item <-> enrollment: creates {class: one-to-one}
      waitlist_entry <-> enrollment: becomes {class: one-to-optional}
      enrollment <-> review: reviewed by {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending Payment {class: st-wait}
        reserved: Reserved {class: st-good}
        in_progress: In Progress {class: st-good}
        passed: Passed {class: st-good}
        failed: Failed {class: st-bad}
        cancelled: Cancelled {class: st-bad}
        refunded: Refunded {class: st-bad}

        s -> pending: seat held for 15 min {class: flow}
        pending -> reserved: payment succeeds {class: flow}
        pending -> cancelled: "hold expires / payment fails" {class: flow}
        reserved -> refunded: "customer cancels / run cancelled" {class: flow}
        reserved -> in_progress: run starts {class: flow}
        in_progress -> passed: trainer records result {class: flow}
        in_progress -> failed: trainer records result {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - A pet can't hold active seats in two runs of the same course at once.
          - A **Passed** enrollment satisfies prerequisites on that course.
          - Retakes are allowed. The customer confirms first.
        | {class: rules}
      }
    }
  }

  waitlist_entry: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Waitlist Entry
      A pet waiting for a seat in a full run.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      waitlist_entry: Waitlist Entry {
        class: t-booking
        id: uuid {constraint: primary_key}
        course_run_id: uuid {constraint: foreign_key}
        pet_id: uuid {constraint: foreign_key}
        customer_id: uuid {constraint: foreign_key}
        status: "enum (see lifecycle)"
        offered_at: datetime
        offer_expires_at: datetime
        enrollment_id: uuid {constraint: foreign_key}
      }

      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      pet: Pet {class: n-people; link: _.layers.pet}
      customer: "User (customer)" {class: n-people; link: _.layers.user}
      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}

      course_run <-> waitlist_entry: has {class: one-to-many}
      pet <-> waitlist_entry: waits in {class: one-to-many}
      customer <-> waitlist_entry: joins {class: one-to-many}
      waitlist_entry <-> enrollment: becomes {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        waiting: Waiting {class: st-wait}
        offered: Offered {class: st-wait}
        enrolled: Enrolled {class: st-good}
        expired: Expired {class: st-bad}
        left_line: left {class: st}
        closed: Closed {class: st}

        s -> waiting: joins (run is full) {class: flow}
        waiting -> offered: "seat frees up, SMS sent" {class: flow}
        offered -> enrolled: pays in time {class: flow}
        offered -> expired: "12 hours pass, next in line" {class: flow}
        waiting -> left_line: customer leaves {class: flow}
        waiting -> closed: "run starts, deadline passes or run cancelled" {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Open only while the run is full and hasn't started.
          - Free to join. One entry per pet per run. Line order is by join time.
          - An offer goes through the normal checkout, with the seat already held.
        | {class: rules}
      }
    }
  }

  # ===== Sales =====

  discount_code: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Discount Code
      Created by the admin. Funded by the platform.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      discount_code: Discount Code {
        class: t-sales
        id: uuid {constraint: primary_key}
        code: "string (case-insensitive)" {constraint: unique}
        description: text
        type: "Percentage | Fixed Amount"
        value: "decimal or rial"
        max_discount_amount: rial
        min_order_amount: rial
        starts_at: datetime
        ends_at: datetime
        total_usage_limit: int
        per_customer_limit: int
        first_order_only: bool
        scope: "All Courses | Selected Courses"
        course_ids: "uuid[]"
        used_count: int
        is_active: bool
      }

      order: Order {class: n-sales; link: _.layers.order}
      course: "Course (when scope is selected)" {class: n-catalogue; link: _.layers.course}

      discount_code <-> order: applied to {class: optional-to-many}
      discount_code <-> course: limited to {class: many-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - One code per order.
          - A fixed amount is split across items in proportion to their price.
          - A use counts when the order is paid, and is given back on a full refund.
          - Discounts never reduce the trainer's earning.
        | {class: rules}
      }
    }
  }

  order: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Order
      One checkout. It can reserve several pets or several runs at once.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      order: Order {
        class: t-sales
        id: uuid {constraint: primary_key}
        order_number: "string (ZR-140507-0042)" {constraint: unique}
        customer_id: uuid {constraint: foreign_key}
        partner_id: "uuid (snapshot)" {constraint: foreign_key}
        discount_code_id: uuid {constraint: foreign_key}
        subtotal: rial
        discount_amount: rial
        total_amount: rial
        paid_from_wallet: rial
        paid_via_gateway: rial
        refunded_amount: rial
        payment_status: "enum (see lifecycle)"
        order_date: datetime
        paid_at: datetime
      }

      customer: "User (customer)" {class: n-people; link: _.layers.user}
      partner: "User (partner)" {class: n-people; link: _.layers.user}
      discount_code: Discount Code {class: n-sales; link: _.layers.discount_code}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}
      payment: Payment {class: n-sales; link: _.layers.payment}
      wallet_transaction: Wallet Transaction {class: n-money; link: _.layers.wallet_transaction}

      customer <-> order: places {class: one-to-many}
      partner <-> order: credited with {class: optional-to-many}
      discount_code <-> order: applied to {class: optional-to-many}
      order <-> order_item: contains {class: one-to-some}
      order <-> payment: paid by {class: one-to-many}
      wallet_transaction -> order: wallet part {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Payment status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending {class: st-wait}
        paid: Paid {class: st-good}
        failed: Failed {class: st-bad}
        cancelled: Cancelled {class: st-bad}
        partial: Partially Refunded {class: st-wait}
        refunded: Refunded {class: st-bad}

        s -> pending: {class: flow}
        pending -> paid: payment succeeds {class: flow}
        pending -> failed: payment fails {class: flow}
        pending -> cancelled: "expires / customer cancels" {class: flow}
        paid -> partial: some seats refunded {class: flow}
        paid -> refunded: all seats refunded {class: flow}
        partial -> refunded: rest refunded {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - The wallet is used first. The gateway pays the rest.
          - The wallet part is taken when the order is created and returned if it fails or expires.
          - The partner is copied at purchase time, so reports never change later.
          - Partner revenue = total − refunded, of paid orders.
        | {class: rules}
      }
    }
  }

  order_item: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Order Item
      One pet's seat in one run, with the prices and rules frozen at purchase.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      order_item: Order Item {
        class: t-sales
        id: uuid {constraint: primary_key}
        order_id: uuid {constraint: foreign_key}
        course_run_id: uuid {constraint: foreign_key}
        pet_id: uuid {constraint: foreign_key}
        unit_price: "rial (snapshot)"
        discount_amount: rial
        paid_amount: rial
        refund_policy_snapshot: json
        trainer_share_snapshot: "decimal (%)"
        refunded_amount: rial
      }

      order: Order {class: n-sales; link: _.layers.order}
      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      pet: Pet {class: n-people; link: _.layers.pet}
      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}
      refund_policy: Refund Policy {class: n-catalogue; link: _.layers.refund_policy}

      order <-> order_item: contains {class: one-to-some}
      course_run <-> order_item: sold as {class: one-to-many}
      pet <-> order_item: booked in {class: one-to-many}
      order_item <-> enrollment: creates {class: one-to-one}
      refund_policy -> order_item: copied at purchase {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - One item per pet per run.
          - Paid amount = unit price − this item's share of the discount.
          - Refunds are based on the paid amount.
          - The trainer earns their share of the **unit price**, not the paid amount.
        | {class: rules}
      }
    }
  }

  payment: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Payment
      One attempt through the online payment gateway.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      payment: Payment {
        class: t-sales
        id: uuid {constraint: primary_key}
        user_id: uuid {constraint: foreign_key}
        purpose: "Order | Wallet Top-up"
        order_id: uuid {constraint: foreign_key}
        amount: rial
        gateway: string
        gateway_authority: string
        reference_id: string
        card_number_masked: string
        status: "Pending | Succeeded | Failed"
        failure_reason: text
        paid_at: datetime
      }

      user: User {class: n-people; link: _.layers.user}
      order: Order {class: n-sales; link: _.layers.order}
      wallet_transaction: "Wallet Transaction (top-up)" {class: n-money; link: _.layers.wallet_transaction}

      user <-> payment: makes {class: one-to-many}
      order <-> payment: paid by {class: one-to-many}
      payment -> wallet_transaction: credits on success {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending {class: st-wait}
        succeeded: Succeeded {class: st-good}
        failed: Failed {class: st-bad}

        s -> pending: sent to gateway {class: flow}
        pending -> succeeded: verified by the server {class: flow}
        pending -> failed: declined or abandoned {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Gateway payments only. Wallet movements live in Wallet Transaction.
          - An order can have several attempts, but only one can succeed.
          - A repeated gateway callback must never reserve or top up twice.
        | {class: rules}
      }
    }
  }

  # ===== Wallet & payouts =====

  wallet: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Wallet
      Real money in Rial. Every user has one.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      wallet: Wallet {
        class: t-money
        id: uuid {constraint: primary_key}
        user_id: uuid {constraint: [foreign_key; unique]}
        balance: rial
        held_amount: rial
      }

      user: User {class: n-people; link: _.layers.user}
      wallet_transaction: Wallet Transaction {class: n-money; link: _.layers.wallet_transaction}
      withdrawal_request: Withdrawal Request {class: n-money; link: _.layers.withdrawal_request}

      user <-> wallet: has {class: one-to-one}
      wallet <-> wallet_transaction: records {class: one-to-many}
      withdrawal_request -> wallet: holds part of the balance {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      money: Money in and out {
        class: lifecycle
        direction: right
        sources: In {
          grid-columns: 1
          grid-gap: 16
          style: {fill: transparent; stroke: transparent}
          top_up: Top-up {class: st-good}
          refund: Refund {class: st-good}
          earning: Trainer earning {class: st-good}
          commission: Partner commission {class: st-good}
          adjust_in: Admin adjustment {class: st}
        }
        balance: Balance {class: st-wait}
        uses: Out {
          grid-columns: 1
          grid-gap: 16
          style: {fill: transparent; stroke: transparent}
          pay: Order payment {class: st-bad}
          withdraw: Withdrawal {class: st-bad}
        }
        sources -> balance: {class: flow}
        balance -> uses: {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Balance = the sum of all its transactions.
          - The balance can never go negative.
          - Held amount is reserved by a pending withdrawal and can't be spent.
          - Spending always uses the oldest credits first.
        | {class: rules}
      }
    }
  }

  wallet_transaction: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Wallet Transaction
      One credit or debit. Never edited, never deleted.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      wallet_transaction: Wallet Transaction {
        class: t-money
        id: uuid {constraint: primary_key}
        wallet_id: uuid {constraint: foreign_key}
        type: "enum (8 types, below)"
        amount: "rial (+ credit / − debit)"
        balance_after: rial
        reference_type: string
        reference_id: uuid
        description: text
        created_by: "uuid (admin)" {constraint: foreign_key}
        reason: text
      }

      wallet: Wallet {class: n-money; link: _.layers.wallet}
      credit_usage: Wallet Credit Usage {class: n-money; link: _.layers.wallet_credit_usage}
      withdrawal_request_item: Withdrawal Request Item {class: n-money; link: _.layers.withdrawal_request_item}

      references: Reference (one of) {
        class: lifecycle
        grid-columns: 1
        grid-gap: 10
        order: Order {class: n-sales; link: _.layers.order}
        payment: Payment {class: n-sales; link: _.layers.payment}
        withdrawal_request: Withdrawal Request {class: n-money; link: _.layers.withdrawal_request}
        trainer_settlement: Trainer Settlement {class: n-money; link: _.layers.trainer_settlement}
        commission_statement: Commission Statement {class: n-partner; link: _.layers.commission_statement}
      }

      wallet <-> wallet_transaction: records {class: one-to-many}
      wallet_transaction <-> credit_usage: "uses / is used by" {class: one-to-many}
      wallet_transaction <-> withdrawal_request_item: listed in {class: one-to-many}
      wallet_transaction -> references: refers to {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Types**
          - Top-up · Order Payment · Order Payment Reversal · Refund
          - Trainer Earning · Commission · Withdrawal · Admin Adjustment

          **Rules**
          - Mistakes are fixed with a new, correcting entry.
          - Admin adjustments always need a reason.
          - What's left of a credit = its amount − what its credit usages took.
        | {class: rules}
      }
    }
  }

  wallet_credit_usage: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Wallet Credit Usage
      Which credits each spending used, so the balance can always be explained.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      wallet_credit_usage: Wallet Credit Usage {
        class: t-money
        id: uuid {constraint: primary_key}
        debit_id: uuid {constraint: foreign_key}
        credit_id: uuid {constraint: foreign_key}
        amount: rial
      }

      debit: "Wallet Transaction (debit)" {class: n-money; link: _.layers.wallet_transaction}
      credit: "Wallet Transaction (credit)" {class: n-money; link: _.layers.wallet_transaction}

      debit <-> wallet_credit_usage: uses {class: one-to-some}
      credit <-> wallet_credit_usage: is used by {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - One debit can use several credits, oldest first.
          - A reversal (e.g. a failed order) links back to the same credits, so the money keeps its source.
          - Never edited or deleted.

          **Example**
          - A balance of 790 thousand toman = 200 from a course refund + 590 from a partner commission.
        | {class: rules}
      }
    }
  }

  withdrawal_request: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Withdrawal Request
      A user asks to move their wallet balance to a bank account.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      withdrawal_request: Withdrawal Request {
        class: t-money
        id: uuid {constraint: primary_key}
        user_id: uuid {constraint: foreign_key}
        requested_amount: rial
        approved_amount: rial
        sheba_number: "IR + 24 digits"
        account_holder_name: string
        status: "enum (see lifecycle)"
        admin_note: text
        rejection_reason: text
        reviewed_by: uuid {constraint: foreign_key}
        reviewed_at: datetime
        paid_at: datetime
        bank_tracking_code: string
      }

      user: User {class: n-people; link: _.layers.user}
      item: Withdrawal Request Item {class: n-money; link: _.layers.withdrawal_request_item}
      wallet: Wallet {class: n-money; link: _.layers.wallet}

      user <-> withdrawal_request: requests {class: one-to-many}
      withdrawal_request <-> item: lists {class: one-to-some}
      withdrawal_request -> wallet: holds the amount {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending {class: st-wait}
        approved: Approved {class: st-good}
        paid: Paid {class: st-good}
        rejected: Rejected {class: st-bad}

        s -> pending: "user requests (amount held)" {class: flow}
        pending -> approved: admin approves selected items {class: flow}
        approved -> paid: admin pays and records tracking code {class: flow}
        pending -> rejected: "admin rejects (hold released)" {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - The admin sees every credit that makes up the balance.
          - Deselected items stay in the wallet and can be spent again.
          - The user is told at each step, including what was left out and why.
        | {class: rules}
      }
    }
  }

  withdrawal_request_item: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Withdrawal Request Item
      One credit inside a withdrawal request, kept or left out by the admin.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      withdrawal_request_item: Withdrawal Request Item {
        class: t-money
        id: uuid {constraint: primary_key}
        withdrawal_request_id: uuid {constraint: foreign_key}
        wallet_transaction_id: uuid {constraint: foreign_key}
        amount: rial
        is_selected: bool
      }

      withdrawal_request: Withdrawal Request {class: n-money; link: _.layers.withdrawal_request}
      wallet_transaction: "Wallet Transaction (credit)" {class: n-money; link: _.layers.wallet_transaction}

      withdrawal_request <-> withdrawal_request_item: lists {class: one-to-some}
      wallet_transaction <-> withdrawal_request_item: listed in {class: one-to-many}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - Amount = what was left of the credit when the request was made.
          - Approved payout = total of the selected items.
          - Example: a top-up that was never spent can be left out.
        | {class: rules}
      }
    }
  }

  trainer_settlement: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Trainer Settlement
      The trainer's earning from one completed run.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      trainer_settlement: Trainer Settlement {
        class: t-money
        id: uuid {constraint: primary_key}
        course_run_id: uuid {constraint: [foreign_key; unique]}
        trainer_id: uuid {constraint: foreign_key}
        seats_sold: int
        gross_sales: rial
        refund_deduction: rial
        trainer_earning: rial
        admin_adjustment: rial
        admin_note: text
        total_amount: rial
        status: "Draft | Approved | Credited"
        approved_by: uuid {constraint: foreign_key}
        approved_at: datetime
        wallet_transaction_id: uuid {constraint: foreign_key}
      }

      course_run: Course Run {class: n-catalogue; link: _.layers.course_run}
      trainer: "User (trainer)" {class: n-people; link: _.layers.user}
      wallet_transaction: Wallet Transaction {class: n-money; link: _.layers.wallet_transaction}
      order_item: Order Item {class: n-sales; link: _.layers.order_item}

      course_run <-> trainer_settlement: settled by {class: one-to-optional}
      trainer <-> trainer_settlement: earns {class: one-to-many}
      trainer_settlement <-> wallet_transaction: credited as {class: one-to-optional}
      order_item -> trainer_settlement: share snapshots {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        draft: Draft {class: st-wait}
        approved: Approved {class: st-good}
        credited: Credited {class: st-good}

        s -> draft: run completed {class: flow}
        draft -> approved: admin reviews and adjusts {class: flow}
        approved -> credited: paid into the wallet {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Earning = trainer share × run price. Discounts are the platform's cost.
          - A partly refunded seat reduces the earning by the same proportion.
          - Partner commission comes from the platform's part, not the trainer's.
        | {class: rules}
      }
    }
  }

  # ===== Partners =====

  partner_lead: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Partner Lead
      A phone number a partner adds before the customer signs up.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      partner_lead: Partner Lead {
        class: t-partner
        id: uuid {constraint: primary_key}
        partner_id: uuid {constraint: foreign_key}
        customer_phone_number: "string (normalized)"
        customer_name: string
        note: text
        status: "Pending | Claimed | Lost"
        claimed_by: "uuid (customer)" {constraint: foreign_key}
        claimed_date: datetime
      }

      partner: "User (partner)" {class: n-people; link: _.layers.user}
      customer: "User (customer)" {class: n-people; link: _.layers.user}

      partner <-> partner_lead: adds {class: one-to-many}
      customer <-> partner_lead: claims {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending {class: st-wait}
        claimed: Claimed {class: st-good}
        lost: Lost {class: st-bad}

        s -> pending: partner adds the number {class: flow}
        pending -> claimed: "customer signs up without a link" {class: flow}
        pending -> lost: "signs up with another partner's link" {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - A referral link or QR code beats a lead.
          - If several partners add the same number, the earliest lead wins.
          - A lead can't be added for a number that's already registered.
        | {class: rules}
      }
    }
  }

  commission_plan: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Commission Plan
      How a partner's monthly commission is calculated. Set by the admin.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      commission_plan: Commission Plan {
        class: t-partner
        id: uuid {constraint: primary_key}
        name: string
        is_default: bool
        first_order_bonus: rial
        attribution_window_months: int
        is_active: bool
      }

      commission_tier: Commission Tier {class: n-partner; link: _.layers.commission_tier}
      partner_profile: Partner Profile {class: n-partner; link: _.layers.partner_profile}
      commission_statement: Commission Statement {class: n-partner; link: _.layers.commission_statement}

      commission_plan <-> commission_tier: has {class: one-to-some}
      commission_plan <-> partner_profile: assigned to {class: optional-to-many}
      commission_plan -> commission_statement: copied into {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Formula**

          ```
          commission = net referred revenue × rate of the tier reached
                     + new customers × first-order bonus
          ```

          **Rules**
          - Exactly one plan is the default. A partner's own plan overrides it.
          - Empty attribution window means orders count forever.
        | {class: rules}
      }
    }
  }

  commission_tier: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Commission Tier
      One step of a plan's rate ladder.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      commission_tier: Commission Tier {
        class: t-partner
        id: uuid {constraint: primary_key}
        commission_plan_id: uuid {constraint: foreign_key}
        from_revenue: rial
        rate_percent: decimal
      }

      commission_plan: Commission Plan {class: n-partner; link: _.layers.commission_plan}

      commission_plan <-> commission_tier: has {class: one-to-some}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      ladder: Example plan {
        class: lifecycle
        direction: right
        t1: "from 0 → 5%" {class: st}
        t2: "from 500M Rial → 7%" {class: st-wait}
        t3: "from 2B Rial → 10%" {class: st-good}

        t1 -> t2 -> t3: {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Unique on (plan, from revenue). The first tier starts at 0.
          - The tier reached applies to **all** of that month's revenue.
          - Example: 800M Rial and 3 new customers with a 1M bonus = 800M × 7% + 3M = 59M Rial.
        | {class: rules}
      }
    }
  }

  commission_statement: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Commission Statement
      A partner's commission for one Jalali month.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      commission_statement: Commission Statement {
        class: t-partner
        id: uuid {constraint: primary_key}
        partner_id: uuid {constraint: foreign_key}
        period: "Jalali month (1405-07)"
        commission_plan_snapshot: json
        net_referred_revenue: rial
        paid_orders_count: int
        new_customers_count: int
        applied_rate_percent: decimal
        revenue_commission: rial
        bonus_amount: rial
        admin_adjustment: rial
        admin_note: text
        total_amount: rial
        status: "Draft | Approved | Credited"
        approved_by: uuid {constraint: foreign_key}
        approved_at: datetime
        wallet_transaction_id: uuid {constraint: foreign_key}
      }

      partner_profile: Partner Profile {class: n-partner; link: _.layers.partner_profile}
      commission_plan: Commission Plan {class: n-partner; link: _.layers.commission_plan}
      order: "Order (referred, paid)" {class: n-sales; link: _.layers.order}
      wallet_transaction: Wallet Transaction {class: n-money; link: _.layers.wallet_transaction}

      partner_profile <-> commission_statement: earns {class: one-to-many}
      commission_plan -> commission_statement: copied into {class: derived}
      order -> commission_statement: net revenue from {class: derived}
      commission_statement <-> wallet_transaction: credited as {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        draft: Draft {class: st-wait}
        approved: Approved {class: st-good}
        credited: Credited {class: st-good}

        s -> draft: start of the next Jalali month {class: flow}
        draft -> approved: admin reviews and adjusts {class: flow}
        approved -> credited: paid into the wallet {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Unique on (partner, period).
          - Net revenue = paid orders in the month − refunds in the month.
          - Plan values are copied, so later plan changes don't alter it.
        | {class: rules}
      }
    }
  }

  # ===== Community =====

  review: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Review
      A customer's rating of a course and its trainer after a run.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      review: Review {
        class: t-community
        id: uuid {constraint: primary_key}
        enrollment_id: uuid {constraint: [foreign_key; unique]}
        customer_id: uuid {constraint: foreign_key}
        pet_id: uuid {constraint: foreign_key}
        course_id: uuid {constraint: foreign_key}
        course_run_id: uuid {constraint: foreign_key}
        trainer_id: uuid {constraint: foreign_key}
        course_rating: "int (1–5)"
        trainer_rating: "int (1–5)"
        comment_id: uuid {constraint: foreign_key}
      }

      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}
      comment: Comment {class: n-community; link: _.layers.comment}
      course: Course {class: n-catalogue; link: _.layers.course}
      trainer_profile: Trainer Profile {class: n-people; link: _.layers.trainer_profile}

      enrollment <-> review: reviewed by {class: one-to-optional}
      review <-> comment: written as {class: one-to-optional}
      review -> course: updates the rating {class: derived}
      review -> trainer_profile: updates the rating {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      rules: {
        class: area
        text: |md
          **Rules**
          - Allowed after the run is **Completed**, once per enrollment.
          - Ratings count toward the averages immediately.
          - The written comment waits for admin approval like any comment.
        | {class: rules}
      }
    }
  }

  comment: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Comment
      A question, comment or reply on a course page.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      comment: Comment {
        class: t-community
        id: uuid {constraint: primary_key}
        course_id: uuid {constraint: foreign_key}
        author_id: uuid {constraint: foreign_key}
        pet_id: uuid {constraint: foreign_key}
        parent_comment_id: uuid {constraint: foreign_key}
        body: text
        status: "enum (see lifecycle)"
        rejection_or_hide_reason: text
        moderated_by: uuid {constraint: foreign_key}
        moderated_at: datetime
      }

      course: Course {class: n-catalogue; link: _.layers.course}
      author: "User (author)" {class: n-people; link: _.layers.user}
      reply: "Comment (reply)" {class: n-community; link: _.layers.comment}
      review: Review {class: n-community; link: _.layers.review}

      course <-> comment: has {class: one-to-many}
      author <-> comment: writes {class: one-to-many}
      comment <-> reply: replied by {class: one-to-many}
      review <-> comment: written as {class: one-to-optional}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Status {
        class: lifecycle
        direction: down
        s: {class: start}
        pending: Pending {class: st-wait}
        approved: Approved {class: st-good}
        rejected: Rejected {class: st-bad}
        hidden: Hidden {class: st}

        s -> pending: customer posts {class: flow}
        s -> approved: "trainer / admin replies" {class: flow}
        pending -> approved: admin approves {class: flow}
        pending -> rejected: admin rejects with reason {class: flow}
        approved -> hidden: admin hides with reason {class: flow}
        hidden -> approved: admin restores {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - Customer comments appear only after admin approval.
          - The owner trainer, trainers who taught a run, and the admin can reply.
          - Replies are one level deep and appear immediately.
          - Hiding a comment hides its replies too.
        | {class: rules}
      }
    }
  }

  # ===== System =====

  otp_code: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # OTP Code
      The one-time SMS code used to sign in.
    | {near: top-center}

    grid-columns: 2
    grid-gap: 64

    er: {
      class: area
      direction: right

      otp_code: OTP Code {
        class: t-system
        id: uuid {constraint: primary_key}
        phone_number: string
        code_hash: string
        expires_at: datetime
        attempts: int
        consumed_at: datetime
        ip_address: string
      }

      user: User {class: n-people; link: _.layers.user}

      otp_code -> user: matched by phone number {class: derived}
    }

    side: {
      class: area
      grid-columns: 1
      grid-gap: 40

      lifecycle: Life of a code {
        class: lifecycle
        direction: down
        s: {class: start}
        sent: Sent {class: st-wait}
        used: Used {class: st-good}
        expired: Expired {class: st-bad}
        locked: Locked {class: st-bad}

        s -> sent: user asks for a code {class: flow}
        sent -> used: correct code {class: flow}
        sent -> expired: 2 minutes pass {class: flow}
        sent -> locked: 5 wrong attempts {class: flow}
      }

      rules: {
        class: area
        text: |md
          **Rules**
          - 5 digits. A new code can be requested after 60 seconds.
          - Rate-limited per phone number and per IP.
          - The code itself is never stored, only its hash.
        | {class: rules}
      }
    }
  }

  platform_setting: {
    back: "← All entities" {class: back; link: _; near: top-left}
    title: |md
      # Platform Setting
      Global values the admin can change without a new release.
    | {near: top-center}

    grid-columns: 1
    grid-gap: 64

    er: {
      class: area
      direction: right

      platform_setting: Platform Setting (defaults) {
        class: t-system
        default_trainer_share: "to be decided"
        seat_hold_during_payment: "15 minutes"
        waitlist_offer_duration: "12 hours"
        otp_validity: "2 minutes"
        otp_resend_wait: "60 seconds"
        otp_max_attempts: "5"
        minimum_withdrawal_amount: "to be decided"
      }

      course: Course {class: n-catalogue; link: _.layers.course}
      enrollment: Enrollment {class: n-booking; link: _.layers.enrollment}
      waitlist_entry: Waitlist Entry {class: n-booking; link: _.layers.waitlist_entry}
      otp_code: OTP Code {class: n-system; link: _.layers.otp_code}
      withdrawal_request: Withdrawal Request {class: n-money; link: _.layers.withdrawal_request}

      platform_setting -> course: pre-fills trainer share {class: derived}
      platform_setting -> enrollment: payment hold {class: derived}
      platform_setting -> waitlist_entry: offer duration {class: derived}
      platform_setting -> otp_code: code rules {class: derived}
      platform_setting -> withdrawal_request: minimum amount {class: derived}
    }
  }
}
